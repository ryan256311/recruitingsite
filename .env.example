# お問い合わせフォーム（Googleスプレッドシートに記録）
# 設置手順は docs/contact-form-setup.md
GAS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxx/exec  # Apps Scriptのウェブアプリ URL
GAS_WEBHOOK_SECRET=xxxxxxxx     # Apps Script側のスクリプトプロパティと同じ値
FILE_ACCESS_SECRET=xxxxxxxx     # 応募書類リンクの署名用（任意の長い文字列）

# Cloudflare R2 (応募書類の保管。バケットは非公開のままにすること)
R2_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
R2_BUCKET_NAME=recruit-files

# microCMS（コンテンツ管理）
MICROCMS_SERVICE_DOMAIN=exceet-recruit # https://xxxxx.microcms.io の xxxxx 部分
MICROCMS_API_KEY=xxxxxxxx              # GET権限のAPIキー
MICROCMS_WEBHOOK_SECRET=xxxxxxxx       # Webhook署名の検証用
DRAFT_PREVIEW_SECRET=xxxxxxxx          # 下書きプレビューURLの保護用（任意の長い文字列）

# 移行スクリプト(npm run migrate:cms)は書き込み権限が必要。
# HobbyプランはAPIキーを1つしか作れないため、上の MICROCMS_API_KEY に
# 管理画面から一時的に POST / PUT 権限を付け、投入後に GET のみへ戻す運用とする。
# 書き込み専用のキーを別に作れるプランでは、ここに設定すればそちらが優先される。
# MICROCMS_WRITE_API_KEY=xxxxxxxx

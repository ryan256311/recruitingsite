# Resend API (メール送信)
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=recruit@exceet.co.jp

# Cloudflare R2 (ファイルストレージ)
R2_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
R2_BUCKET_NAME=recruit-files
R2_PUBLIC_URL=https://files.yourdomain.com

# または AWS S3 を使用する場合
# S3_ENDPOINT=https://s3.ap-northeast-1.amazonaws.com
# AWS_ACCESS_KEY_ID=xxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
# S3_BUCKET_NAME=recruit-files
# S3_PUBLIC_URL=https://your-bucket.s3.ap-northeast-1.amazonaws.com

# microCMS（コンテンツ管理）
MICROCMS_SERVICE_DOMAIN=xxxxx          # https://xxxxx.microcms.io の xxxxx 部分
MICROCMS_API_KEY=xxxxxxxx              # GET権限のAPIキー
MICROCMS_WRITE_API_KEY=xxxxxxxx        # POST/PUT権限。移行スクリプト用（Vercelには登録しない）
MICROCMS_WEBHOOK_SECRET=xxxxxxxx       # Webhook署名の検証用
DRAFT_PREVIEW_SECRET=xxxxxxxx          # 下書きプレビューURLの保護用（任意の長い文字列）
